# Normalize text files to LF in the repository.
* text=auto

# Windows-only files must retain CRLF everywhere.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Files that must remain LF everywhere.
*.sh text eol=lf

# Explicitly mark binary formats; prevents accidental conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.woff binary
*.woff2 binary
